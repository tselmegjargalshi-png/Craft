# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, or local Postgres).
# Local example: postgresql://craft:craft@localhost:5432/craft
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# Direct (non-pooled) connection used by `prisma db push`; same as DATABASE_URL unless you use a pooler
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Admin account created/updated by `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-to-a-long-random-password"

# Secret used to sign admin session cookies. Generate: openssl rand -base64 48
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Public site URL (used for sitemap, canonical and Open Graph URLs)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
