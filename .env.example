# Database (SQLite file, relative to prisma/schema.prisma). For Postgres see README.
DATABASE_URL="file:./dev.db"

# Admin account created/updated by `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-to-a-long-random-password"

# Secret used to sign admin session cookies. Generate: openssl rand -base64 48
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Public site URL (used for sitemap, canonical and Open Graph URLs)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
